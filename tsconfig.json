{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node", "vite-plugin-pwa/react"],

    /* Strict beyond the default. Bookkeeping is unforgiving about the cases
       these flags catch: an absent array element, an optional field that is
       present but undefined, an unhandled switch branch. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vite.agent.config.ts",
    "playwright.config.ts"
  ]
}
