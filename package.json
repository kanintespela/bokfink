{
  "name": "kontera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first PWA for Swedish sole-proprietor bookkeeping",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run assets:ocr",
    "build": "vite build",
    "prebuild": "npm run assets:ocr",
    "preview": "vite preview --host",
    "agent": "vite build --config vite.agent.config.ts --logLevel error && node dist-agent/kontera-agent.mjs",
    "assets:ocr": "node scripts/kopiera-tesseract.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:run",
    "test:e2e": "playwright test",
    "pretest:e2e": "npm run assets:ocr"
  },
  "dependencies": {
    "@tesseract.js-data/swe": "^1.0.0",
    "dexie": "^4.4.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
